NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
PORT=5000
CLIENT_URL=http://localhost:5173
TRUST_PROXY_HOPS=0

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tinhdoan_thitructuyen
# Tạo khóa riêng trên máy bằng lệnh: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h
OTP_ENABLED=false
OTP_EXPIRES_MINUTES=5
OTP_DEV_MODE=false

# Khi OTP_ENABLED=false, đăng ký/quên mật khẩu không gửi email và không cần SMTP.
# Luồng email OTP cũ chỉ chạy khi bật OTP_ENABLED=true rõ ràng; chưa tích hợp SMS.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
# Preferred: Brevo Transactional Email API key (Brevo > SMTP & API).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Thi truc tuyen Tinh Doan

# Or use Brevo SMTP relay: smtp-relay.brevo.com:587.
# No MAIL_* values are needed when BREVO_API_KEY is configured.
MAIL_FROM=
